# 原站分析产物（原站 HTML/CSS/录屏/抽帧，含原站版权内容，仅本地参考，不入库）
dottxt/analysis/

# 分析时抓取的原站构建 chunk
dottxt/[0-9]*-*.js

# 系统杂项
Thumbs.db
.DS_Store

animejs/node_modules/
animejs/dist/

baseline-motion/node_modules/
baseline-motion/dist/

# 角色资产的中间产物：.blend 内嵌 4K 贴图，单个就 29MB+，且都可由 tools/ 重跑得到
coach/build/
# 冻结的 High Source（30MB，本地保留即可）
coach/reference/*.glb

# Ruth 角色资产的中间产物（可由 ruth/tools/ 重跑得到）
# build/ 内含多个 .blend，每个都打包了 2K 贴图，合计 ~1 GB
ruth/build/
# 冻结的 High Source（28MB，本地保留即可）
ruth/reference/*.glb
__pycache__/
